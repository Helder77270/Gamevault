# Copy to .env (gitignored) and fill in. NEVER put real values in this file.

# Platform signing key (secp256k1 priv, 0x-hex). Unset = DEV key (fixtures only).
PLATFORM_PRIVKEY=

# GameLicense (ERC-721) address on Base Sepolia. Unset = ownerOf()
# check SKIPPED (dev mode until P1 contracts are deployed).
GAMELICENSE_ADDRESS=

# Optional RPC override (defaults to the public base-sepolia RPC)
RPC_URL=

PORT=8787
