# Copy to .env (gitignored) and fill in. NEVER put real values in this file.
# Each key has ONE role (audit K1). Generate keys locally, never paste them in chat.

# Signs launch tickets (secp256k1 private key, 0x-hex). Its public key is
# embedded in the launcher (launcher/src/main.ts + src-tauri/src/ticket.rs).
# Unset = DEV key, accepted only with GAMEVAULT_DEV=1 and debug launchers.
TICKET_SIGNER_PRIVKEY=

# Signs EIP-712 friendship attestations read by GameLicense.lend(). Must match
# GameLicense.attestationSigner on-chain (admin can rotate it).
ATTEST_SIGNER_PRIVKEY=

# 32-byte hex master key encrypting the game content keys at rest (SQLite).
# Keep a copy OUTSIDE this machine: losing it loses every published game key.
KEYSTORE_MASTER_KEY=

# Pinata JWT (pinFileToIPFS only) used by POST /publish.
PINATA_JWT=

# Optional overrides — defaults come from shared/src/deployments.ts.
GAMELICENSE_ADDRESS=
RPC_URL=

# Network: loopback by default (127.0.0.1 + ::1). Extra CORS origins, comma-separated.
PORT=8787
HOST=
CORS_ORIGINS=

# GAMEVAULT_DEV=1 lives in .env.dev (loaded by `npm run dev`): enables the
# /friends/backdate helper and the DEV key fallbacks. Never set it in prod.
