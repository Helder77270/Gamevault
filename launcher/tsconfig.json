{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@gamevault/shared/registryCatalog": ["../shared/src/registryCatalog.ts"],
      "@gamevault/shared/deployments": ["../shared/src/deployments.ts"],
      "@gamevault/shared/storage": ["../shared/src/storage.ts"],
      "@gamevault/shared/abi": ["../shared/src/abi.ts"],
      "@gamevault/shared/siwe": ["../shared/src/siwe.ts"],
      "@gamevault/shared": ["../shared/src/index.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
