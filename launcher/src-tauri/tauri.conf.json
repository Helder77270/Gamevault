{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameVault Launcher",
  "version": "0.1.0",
  "identifier": "com.gamevault.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "AURA-64 · GameVault",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com",
        "img-src": "'self' data: blob: http://localhost:8787 http://127.0.0.1:8787",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:8787 http://127.0.0.1:8787 https://sepolia.base.org https://gateway.pinata.cloud https://ipfs.io https://dweb.link",
        "frame-src": "game: http://game.localhost",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com",
        "img-src": "'self' data: blob: http://localhost:8787 http://127.0.0.1:8787",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:8787 http://127.0.0.1:8787 https://sepolia.base.org https://gateway.pinata.cloud https://ipfs.io https://dweb.link",
        "frame-src": "game: http://game.localhost",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
