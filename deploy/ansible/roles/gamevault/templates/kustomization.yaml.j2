# Rendered by Ansible ({{ web_domain }}) — do not edit on the server.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: gamevault
resources:
  - ../base
images:
  - name: ghcr.io/gamevault/ticketd
    newName: {{ image_registry }}/ticketd
    newTag: "{{ ticketd_image_tag }}"
  - name: ghcr.io/gamevault/web
    newName: {{ image_registry }}/web
    newTag: "{{ web_image_tag }}"
patches:
  - path: config-patch.yaml
{% for ing in ['web'] %}
  - target: { group: networking.k8s.io, version: v1, kind: Ingress, name: {{ ing }} }
    patch: |-
      - { op: replace, path: /spec/rules/0/host, value: {{ web_domain }} }
      - { op: replace, path: /spec/tls/0/hosts/0, value: {{ web_domain }} }
{% endfor %}
{% for ing in ['api', 'api-auth', 'api-publish', 'api-stream'] %}
  - target: { group: networking.k8s.io, version: v1, kind: Ingress, name: {{ ing }} }
    patch: |-
      - { op: replace, path: /spec/rules/0/host, value: {{ api_domain }} }
      - { op: replace, path: /spec/tls/0/hosts/0, value: {{ api_domain }} }
{% endfor %}
  - target: { group: autoscaling, version: v2, kind: HorizontalPodAutoscaler, name: web }
    patch: |-
      - { op: replace, path: /spec/minReplicas, value: {{ web_min_replicas }} }
      - { op: replace, path: /spec/maxReplicas, value: {{ web_max_replicas }} }
  - target: { group: apps, version: v1, kind: StatefulSet, name: ticketd }
    patch: |-
      - { op: replace, path: /spec/volumeClaimTemplates/0/spec/resources/requests/storage, value: {{ ticketd_storage }} }
